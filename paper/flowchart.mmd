---
config:
  theme: base
  look: classic
  themeVariables:
    fontFamily: 'Latin Modern Roman, serif'
    fontSize: '16px'
    primaryColor: '#e3f2fd'
    primaryTextColor: '#0d2a4a'
    primaryBorderColor: '#1565c0'
    lineColor: '#546e7a'
    edgeLabelBackground: '#ffffff'
  flowchart:
    curve: basis
    nodeSpacing: 40
    rankSpacing: 50

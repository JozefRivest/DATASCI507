        {
            "box": [
                30,
                17,
                1305,
                247
            ],
            "contents": "自民·維新の金権·腐敗政治に帰っ!\nくらし·平和·人権を守ります !!",
            "direction": "horizontal",
            "order": 0,
            "role": null
        },
        {
            "box": [
                16,
                204,
                194,
                683
            ],
            "contents": "比例代表は\n日本共産党\nとお書きください",
            "direction": "vertical",
            "order": 1,

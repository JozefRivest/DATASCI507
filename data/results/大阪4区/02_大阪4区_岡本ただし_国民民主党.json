        {
            "box": [
                26,
                8,
                1536,
                170
            ],
            "contents": "もっと手取りを\n増やす\n大阪の新しい選択肢",
            "direction": "horizontal",
            "order": 0,
            "role": "section_headings"
        },
        {
            "box": [
                37,
                223,
                371,
                268
            ],
            "contents": "もっと手取りを増やす!",
            "direction": "horizontal",
            "order": 1,
            "role": null
        },
        {
            "box": [
                46,
                291,
                376,
                404
            ],
            "contents": "社会保険料負担の軽減と住民税の\n控除額「110万円の壁」を178万円\nまで引き上げて、手取りを増やす!",
            "direction": "horizontal",
            "order": 2,
            "role": null
        },
        {
            "box": [
                109,
                434,
                380,
                494
            ],
            "contents": "減税と社会保険料負担の軽減で、働く\n全ての現役世代の手取りを増やし、\n人手不足を解消します!",
            "direction": "horizontal",
            "order": 3,
            "role": null
        },
        {
            "box": [
                432,
                223,
                767,
                267
            ],
            "contents": "中小企業とフリーランスを元気に!",
            "direction": "horizontal",
            "order": 4,
            "role": null
        },
        {
            "box": [
                439,
                291,
                772,
                404
            ],
            "contents": "設備投資を促進し、賃上\nげに。そしてインボイスは\n廃止へ。",
            "direction": "horizontal",
            "order": 5,
            "role": null
        },
        {
            "box": [
                450,
                446,
                478,
                486
            ],
            "contents": "囲",
            "direction": "horizontal",
            "order": 6,
            "role": null
        },
        {
            "box": [
                505,
                439,
                772,
                489
            ],
            "contents": "社会保険料の事業主負担の助成\nも行い、正規雇用を促進します。",
            "direction": "horizontal",
            "order": 7,
            "role": null
        },
        {
            "box": [
                827,
                223,
                1155,
                268
            ],
            "contents": "持続可能な国作り",
            "direction": "horizontal",
            "order": 8,
            "role": null
        },
        {
            "box": [
                836,
                291,
                1168,
                404
            ],
            "contents": "食·エネルギーの自給率を\nしっかり高め、自国は自国\nでしっかり守る。",
            "direction": "horizontal",
            "order": 9,
            "role": null
        },
        {
            "box": [
                843,
                433,
                897,
                490
            ],

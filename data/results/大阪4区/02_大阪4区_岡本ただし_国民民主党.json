        {
            "box": [
                1224,
                223,
                1559,
                268
            ],
            "contents": "子育て世帯の税負担を軽く!",
            "direction": "horizontal",
            "order": 14,
            "role": null
        },
        {
            "box": [
                1232,
                291,
                1565,
                404
            ],
            "contents": "年少扶養控除の復活、教育\nの所得制限撤廃で家計を\n応援。",
            "direction": "horizontal",
            "order": 15,
            "role": null
        },
        {
            "box": [
                1296,
                440,
                1565,
                489
            ],
            "contents": "教育や生活にかかる費用を軽く\nし、子育てを応援します。",
            "direction": "horizontal",
            "order": 16,
            "role": null

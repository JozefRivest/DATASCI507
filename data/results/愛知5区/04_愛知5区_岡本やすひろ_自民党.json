    "paragraphs": [
        {
            "box": [
                46,
                30,
                736,
                77
            ],
            "contents": "岡本やすひろが実現する9つの政策",
            "direction": "horizontal",
            "order": 0,
            "role": "section_headings"
        },
        {
            "box": [
                25,
                97,
                333,
                147
            ],
            "contents": "1 食卓に笑顔を。\n飲食料品の消費税ゼロの実現",
            "direction": "horizontal",
            "order": 1,
            "role": null
        },
        {
            "box": [
                25,
                154,
                242,
                205
            ],
            "contents": "2 物価高に負けない!\n賃上げと給付の実現",
            "direction": "horizontal",
            "order": 2,
            "role": null
        },
        {
            "box": [
                25,
                211,
                348,
                262
            ],
            "contents": "3 年収の壁を突破し、働きたい人が\n損をしない制度の実現",
            "direction": "horizontal",
            "order": 3,
            "role": null
        },
        {
            "box": [
                25,
                268,
                217,
                293
            ],
            "contents": "4 地域医療を守り、",
            "direction": "horizontal",
            "order": 4,
            "role": null
        },
        {
            "box": [
                49,
                298,
                323,
                319
            ],
            "contents": "病気を未然に防ぐ健康社会の実現",
            "direction": "horizontal",
            "order": 5,
            "role": null
        },
        {
            "box": [
                25,
                325,
                311,
                377
            ],
            "contents": "5 高齢者の方のために、\n地域包括ケアの充実を実現",
            "direction": "horizontal",
            "order": 6,
            "role": null
        },
        {
            "box": [
                382,
                97,
                666,
                147
            ],
            "contents": "6 所得制限なしの\n子ども医療費無償化の実現",
            "direction": "horizontal",
            "order": 7,
            "role": null
        },
        {
            "box": [
                380,
                153,
                751,
                178
            ],
            "contents": "7 仕事と育児の両立ができる制度の実現",
            "direction": "horizontal",
            "order": 8,
            "role": null
        },
        {
            "box": [
                381,
                184,
                716,
                235
            ],
            "contents": "8 南海トラフ巨大地震などに対する\n災害対策強化の実現",
            "direction": "horizontal",
            "order": 9,
            "role": null
        },
        {
            "box": [
                381,
                241,
                693,
                293
            ],
            "contents": "9 名古屋、清須の、\nさらに魅力あるまち創りの実現",
            "direction": "horizontal",
            "order": 10,
            "role": null
        },
        {
            "box": [
                409,
                297,
                751,
                326
            ],
            "contents": "·東京、大阪に負けない魅力ある名古屋駅周辺のまち創りを迅速に\n取り組みます。",
            "direction": "horizontal",
            "order": 11,
            "role": null
        },
        {
            "box": [
                409,
                329,
                745,
                343
            ],
            "contents": "·中川運河や高畑エリアの魅力ある新たな賑わいを創り上げます。",
            "direction": "horizontal",
            "order": 12,
            "role": null
        },
        {
            "box": [
                409,
                345,
                751,
                375
            ],
            "contents": "·名古屋駅と清須を歴史と伝統文化で繋ぎ、利便性の向上と地域の\n発展を創り上げます。",
            "direction": "horizontal",
            "order": 13,
            "role": null
        },
        {
            "box": [
                823,
                16,
                982,
                141
            ],
            "contents": "いま、日本を取り巻く世界情\n勢は目まぐるしく変化して\nおり、物価高騰や電気、ガス\n等の生活費の圧迫が我々\n国民の負担になっています。\n物価高に負けない力強い\n賃上げと所得向上を実現し\nます、また、南海トラフ巨大\n地震などの大規模自然災害\nに備え、災害対策を更に強化\nします。\n地方の声を国政へ、生まれ",
            "direction": "vertical",
            "order": 14,
            "role": null
        },
        {
            "box": [
                791,
                17,
                833,
                141
            ],
            "contents": "地方の声を国政へ、生まれ\n育った地域の活性化へ全力\nを尽くします。",
            "direction": "vertical",
            "order": 15,
            "role": null
        },
        {
            "box": [
                989,
                17,
                1038,
                142
            ],
            "contents": "地域の活性化\nを全力で実現",
            "direction": "vertical",
            "order": 16,
            "role": null
        },

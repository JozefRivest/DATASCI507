        {
            "box": [
                27,
                18,
                1541,
                180
            ],
            "contents": "もっと手取りゃ\n増やす\n大阪の新しい選択肢",
            "direction": "horizontal",
            "order": 0,
            "role": "section_headings"
        },
        {
            "box": [
                36,
                232,
                369,
                277
            ],
            "contents": "もっと手取りを増やす!",
            "direction": "horizontal",
            "order": 1,
            "role": null
        },
        {
            "box": [
                44,
                300,
                375,
                413
            ],
            "contents": "社会保険料負担の軽減と住民税の\n控除額 110万円の壁」を178万円\nまで引き上げて、手取りを増やす!",
            "direction": "horizontal",
            "order": 2,
            "role": null
        },
        {
            "box": [
                109,
                443,
                379,
                503
            ],
            "contents": "減税と社会保険料負担の軽減で、働く\n全ての現役世代の手取りを増やし、\n人手不足を解消します!",
            "direction": "horizontal",
            "order": 3,
            "role": null
        },
        {
            "box": [
                432,
                232,
                765,
                277
            ],
            "contents": "中小企業とフリーランスを元気に!",
            "direction": "horizontal",
            "order": 4,
            "role": null
        },
        {
            "box": [
                437,
                300,
                770,
                413
            ],
            "contents": "設備投資を促進し、賃上\nげに。そしてインボイスは\n廃止へ。",
            "direction": "horizontal",
            "order": 5,
            "role": null
        },
        {
            "box": [
                503,
                448,
                772,
                498
            ],
            "contents": "社会保険料の事業主負担の助成\nも行い、正規雇用を促進します。",
            "direction": "horizontal",
            "order": 6,
            "role": null
        },
        {
            "box": [
                829,
                232,
                1160,
                277
            ],
            "contents": "医療、介護、福祉を守る",
            "direction": "horizontal",
            "order": 7,
            "role": null
        },
        {
            "box": [
                834,
                300,
                1168,
                413
            ],
            "contents": "地域医療、介護、福祉は\n人として在るべき最後の\nセーフティネット。",
            "direction": "horizontal",
            "order": 8,
            "role": null
        },
        {
            "box": [
                851,
                455,
                884,
                492
            ],
            "contents": "9",

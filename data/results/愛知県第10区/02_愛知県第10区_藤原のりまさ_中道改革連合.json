    "paragraphs": [
        {
            "box": [
                8,
                8,
                39,
                380
            ],
            "contents": "みなさんの声が、みちしるべです。",
            "direction": "vertical",
            "order": 0,
            "role": null
        },
        {
            "box": [
                149,
                0,

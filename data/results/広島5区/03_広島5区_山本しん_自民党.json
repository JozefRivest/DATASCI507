        {
            "box": [
                154,
                312,
                475,
                404
            ],
            "contents": "平成10年4月\n広島学院中学校 入学\n平成13年4月\n広島学院高等学校 入学\n平成16年4月\n慶應義塾大学経済学部 入学\n平成21年3月\n慶應義塾大学経済学部 卒業",
            "direction": "horizontal",

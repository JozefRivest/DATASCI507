            "paragraphs": [
                {
                    "box": [
                        2119,
                        40,
                        2169,
                        270
                    ],
                    "contents": "自民党公認",
                    "direction": "vertical",
                    "order": 0,
                    "role": null
                },
                {
                    "box": [
                        1916,
                        43,
                        2101,
                        656
                    ],
                    "contents": "ひらぐち\nHOOKO",
                    "direction": "vertical",
                    "order": 1,
                    "role": null
                },
                {
                    "box": [
                        1400,
                        46,
                        1634,
                        649
                    ],
                    "contents": "全力政治 !\n食料品消費税ゼロ·\n物価高対策·賃金の引き上げ",
                    "direction": "vertical",
                    "order": 2,
                    "role": null
                },
                {
                    "box": [
                        1333,
                        46,
                        1390,
                        655
                    ],
                    "contents": "食料品の消費税をゼロとし、米などの農産物、ガソリン、一般商品の\n物価を抑制します。また物価高を上回る賃金の引き上げを行います。",
                    "direction": "vertical",
                    "order": 3,
                    "role": null
                },
                {
                    "box": [
                        1177,
                        45,
                        1312,
                        653
                    ],
                    "contents": "2政治改革の実施\n政治資金の更なる透明化を図ります。そのため、独立性が確保\nされた公平な第三者機関を設置します。また、政治団体の代表者の\n責任強化を図ります。",
                    "direction": "vertical",
                    "order": 4,
                    "role": null
                },
                {
                    "box": [
                        1113,
                        59,
                        1155,
                        435
                    ],
                    "contents": "3少子化社会を克服",
                    "direction": "vertical",
                    "order": 5,
                    "role": null
                },
                {
                    "box": [
                        1016,
                        44,
                        1096,
                        653
                    ],
                    "contents": "子どもや子育ての支援制度をさらに充実させます。\n若年世代の所得を増やすとともに、子どもまん中社会を形成して\n子育て世帯を切れ目なく支援します。",
                    "direction": "vertical",
                    "order": 6,
                    "role": null
                },
                {
                    "box": [
                        954,
                        56,
                        996,
                        393
                    ],
                    "contents": "4地方創生の実現",
                    "direction": "vertical",
                    "order": 7,
                    "role": null
                },
                {
                    "box": [
                        916,
                        46,
                        941,
                        652
                    ],
                    "contents": "「まち·ひと·しごと」の取り組みを強化して「地方創生」の実現を",
                    "direction": "vertical",
                    "order": 8,
                    "role": null
                },
                {
                    "box": [
                        885,
                        44,
                        910,
                        414
                    ],
                    "contents": "図り、東京一極集中に歯止めをかけます。",
                    "direction": "vertical",
                    "order": 9,
                    "role": null
                },
                {
                    "box": [
                        827,
                        54,
                        864,
                        433
                    ],
                    "contents": "5教育の完全無償化",
                    "direction": "vertical",
                    "order": 10,
                    "role": null
                },
                {
                    "box": [
                        788,
                        44,
                        809,
                        651
                    ],
                    "contents": "給食費の無償化、奨学金の返済不要等を通じ教育の完全無償化を",
                    "direction": "vertical",
                    "order": 11,
                    "role": null
                },
                {
                    "box": [
                        754,
                        41,
                        785,
                        138
                    ],
                    "contents": "図ります。",
                    "direction": "vertical",
                    "order": 12,
                    "role": null
                },
                {
                    "box": [
                        697,
                        57,
                        738,
                        433
                    ],
                    "contents": "6国土強靭化の達成",
                    "direction": "vertical",
                    "order": 13,
                    "role": null
                },
                {
                    "box": [
                        660,
                        45,
                        681,
                        649
                    ],
                    "contents": "多発する自然災害に対応するため、道路·河川·下水道の防災·",
                    "direction": "vertical",
                    "order": 14,
                    "role": null
                },
                {
                    "box": [
                        627,
                        42,
                        654,
                        269
                    ],
                    "contents": "減災機能を強化します。",
                    "direction": "vertical",
                    "order": 15,
                    "role": null
                },
                {
                    "box": [
                        597,
                        42,
                        625,
                        643
                    ],
                    "contents": "また、老朽化した施設の更新を図り、災害に強い国土を形成します。",
                    "direction": "vertical",
                    "order": 16,
                    "role": null
                },
                {
                    "box": [
                        535,
                        62,
                        578,
                        474
                    ],
                    "contents": "7世界恒久平和の実現",
                    "direction": "vertical",
                    "order": 17,
                    "role": null
                },
                {
                    "box": [
                        438,
                        46,
                        525,
                        652
                    ],
                    "contents": "平和の象徴としての旧陸軍被服支廠の保存を図ります。「核兵器\nのない世界」をめざして一歩一歩実践的な取り組みを進めると\nともに世界の恒久平和に向けて歩を進めます。",
                    "direction": "vertical",
                    "order": 18,
                    "role": null
                },
                {
                    "box": [
                        142,
                        132,
                        410,
                        205
                    ],
                    "contents": "【平口ひろしプロフィール】\n法務大臣",
                    "direction": "horizontal",
                    "order": 19,
                    "role": null
                },
                {
                    "box": [
                        138,
                        220,
                        395,
                        541
                    ],
                    "contents": "衆議院議員6期\n昭和23年8月1日生まれ\n広島学院高等学校卒業\n東京大学法学部卒業\n秋田県警察本部長\n国土交通省河川局次長\n平成27年 環境副大臣\n平成30年 法務副大臣\n令和4年 自由民主党\n広島県支部連合会会長\n令和5年 自由民主党広報本部\n副本部長·報道局長\n令和7年 法務大臣",
                    "direction": "horizontal",
                    "order": 20,
                    "role": null
                },

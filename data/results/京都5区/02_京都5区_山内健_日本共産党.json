    "paragraphs": [
        {
            "box": [
                35,
                37,
                525,
                90
            ],
            "contents": "憲法を真ん中に英国の力で",
            "direction": "horizontal",
            "order": 0,
            "role": null
        },
        {
            "box": [
                594,
                38,
                866,
                102
            ],
            "contents": "日本共産党\n5\n衆議院京都\n区候補",
            "direction": "horizontal",
            "order": 1,
            "role": "section_headings"
        },
        {
            "box": [
                47,
                502,
                819,
                540
            ],
            "contents": "Profile●1968年生まれ。同志社大学法学部卒。党京都府委員会労働部副部長として青年雇用問題にとりくむ。党舞鶴地\n区委員長を経て、2015年から中丹地区委員長。5区国政委員長として、平和や原発問題、ジェンダー平等の実現にとりくむ。",
            "direction": "horizontal",
            "order": 3,
            "role": null
        },
        {
            "box": [
                862,
                514,
                893,
                531
            ],
            "contents": "HP",
            "direction": "horizontal",
            "order": 4,
            "role": null
        },
        {
            "box": [
                1015,
                468,
                1047,
                502
            ],
            "contents": "G",
            "direction": "horizontal",
            "order": 6,
            "role": null
        },
        {
            "box": [
                929,
                516,
                1098,
                540
            ],
            "contents": "@kyamauchi2",
            "direction": "horizontal",
            "order": 7,
            "role": null
        },
        {
            "box": [
                79,
                562,
                1062,
                605
            ],
            "contents": "ごいっしよにつくりましょう––住みつづけられる京都北部",
            "direction": "horizontal",
            "order": 8,
            "role": null
        },
        {
            "box": [
                56,
                613,
                1092,
                653
            ],
            "contents": "くらし·平和·人権 国民のためにプレずにがんばる 安保法制廃止·原発ゼロ",
            "direction": "horizontal",
            "order": 9,
            "role": null
        },
        {
            "box": [
                38,
                663,
                349,
                724
            ],
            "contents": "賃上げと労働時間短縮で\n自由時間を拡大",
            "direction": "horizontal",
            "order": 10,
            "role": null
        },
        {
            "box": [
                36,
                730,
                450,
                816
            ],
            "contents": "賃上げと一体に「1日7時間、週35時間」労働に。\n最低賃金を1500円に引き上げ\nケア労働者の賃金·待遇の抜本的改善",
            "direction": "horizontal",
            "order": 11,
            "role": null
        },
        {
            "box": [
                37,
                830,
                333,
                860
            ],
            "contents": "|若者·子育て世代を応援",
            "direction": "horizontal",
            "order": 12,
            "role": "section_headings"
        },
        {
            "box": [
                35,
                866,
                549,
                922
            ],
            "contents": "大学·専門学校の学費半額、入学金ゼロ。給付型奨学金を拡大\n高校卒業まで医療費を無料に小中学校の給食を無償に",
            "direction": "horizontal",
            "order": 13,
            "role": null
        },
        {
            "box": [
                54,
                936,
                314,
                996
            ],
            "contents": "大軍拡やめ9条生かす\n平和外交に切り替え",
            "direction": "horizontal",
            "order": 14,
            "role": "section_headings"
        },
        {
            "box": [
                36,
                1002,
                551,
                1088
            ],
            "contents": "軍事ブロックやめASEAN中心の平和外交、核兵器禁止条\n約を批准。舞鶴自衛隊へのトマホーク配備反対。米軍レー\nダー基地撤去",
            "direction": "horizontal",
            "order": 15,
            "role": null
        },
        {
            "box": [
                37,
                1101,
                528,
                1162
            ],
            "contents": "|ムダと環境破壊の北陸新幹線延伸は中止\n鉄道·バス·タクシーなど身近な交通の充実",
            "direction": "horizontal",
            "order": 16,
            "role": null
        },
        {
            "box": [
                608,
                663,
                953,
                722
            ],
            "contents": "物価高騰から暮らし·営業守る\n農業つぶしストップ",
            "direction": "horizontal",
            "order": 17,
            "role": null
        },
        {
            "box": [
                588,
                729,
                1103,
                846
            ],
            "contents": "消費税は全て5%に減税、賃金と年金の大幅アップ\n医療·介護·福祉の充実で北部経済を元気に。農漁業を基幹\n産業に、減反やめコメ作り推奨。価格保障·戸別所得補償で\n農家を元気に",
            "direction": "horizontal",
            "order": 18,
            "role": null
        },
        {
            "box": [
                589,
                860,
                946,
                890
            ],
            "contents": "| 気候危機打開。原発ゼロ決断",
            "direction": "horizontal",
            "order": 19,
            "role": null
        },
        {
            "box": [
                589,
                897,
                1101,
                982
            ],
            "contents": "北部を脱炭素·再エネ中心の先進地域に\n災害に強いまちづくりをハード·ソフト両面でさらに推進。\n国の責任でPFAS検査を実施",
            "direction": "horizontal",
            "order": 20,
            "role": null
        },
        {
            "box": [
                607,
                996,
                896,
                1057
            ],
            "contents": "差別と排外主義を許さず\nジェンダー平等つらぬく",
            "direction": "horizontal",
            "order": 21,
            "role": "section_headings"
        },
        {
            "box": [
                590,
                1063,
                1104,
                1119
            ],
            "contents": "男女の賃金格差解消。選択的夫婦別姓·同性婚認める民法\n改正。パートナーシップ制を推進",
            "direction": "horizontal",
            "order": 22,
            "role": null
        }
    ],

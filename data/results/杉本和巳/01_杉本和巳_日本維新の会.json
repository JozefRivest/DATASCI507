                874,
                232
            ],
            "contents": "手取りを増やす。",
            "direction": "vertical",
            "order": 9,
            "role": null
        },
        {
            "box": [
                708,
                103,
                852,
                384
            ],
            "contents": "●日銀保有ETFを活用し年金内容を改\n良、年金持続可能性を高め、年金を守る。\n●防衛力·抑止力を高めて命を守りぬく。\n●日本人らしさと自然·歴史·文化を大切\nにする環境立国·観光立国へ、\n●動物愛護で人や生き物にやさしい社会",
            "direction": "vertical",
            "order": 10,
            "role": null
        },
        {
            "box": [
                694,
                114,
                716,
                171
            ],
            "contents": "つくり。",
            "direction": "vertical",

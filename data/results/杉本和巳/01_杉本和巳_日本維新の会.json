        {
            "box": [
                237,
                13,
                1002,
                101
            ],
            "contents": "行財政政室のエンジンとして\n高市運立坂権の改革をスピードアップ!",
            "direction": "horizontal",
            "order": 1,
            "role": "section_headings"
        },
        {
            "box": [
                1073,
                151,
                1189,
                380
            ],
            "contents": "日本維新の会公認\nみ\nかず\nすぎ もと\n杉本和巳",
            "direction": "vertical",
            "order": 2,
            "role": null
        },
        {
            "box": [
                1002,
                106,
                1027,
                381
            ],
            "contents": "あなたのくらしと命を守りぬく",
            "direction": "vertical",

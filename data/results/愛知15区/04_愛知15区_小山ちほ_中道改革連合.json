    "paragraphs": [
        {
            "box": [
                1063,
                167,
                1218,
                319
            ],
            "contents": "ち小\nほ山",
            "direction": "horizontal",
            "order": 1,
            "role": "section_headings"
        },
        {
            "box": [
                862,
                34,
                1031,
                278
            ],
            "contents": "あきらめない\n思いが未来を創る\nある日、出産したその日から\n「障がい児の母」となりました。\n国内でも数少ない\n指定難病 ..",
            "direction": "vertical",
            "order": 2,
            "role": null
        },
        {
            "box": [
                761,
                34,
                854,
                239
            ],
            "contents": "苦難の日々の始まりでした。\nこの体験が政治に挑戦する\nきっかけとなりました。\nまさに「生きにくさ」とは",
            "direction": "vertical",
            "order": 3,
            "role": null
        },
        {
            "box": [
                738,
                35,
                756,
                166
            ],
            "contents": "環境や社会側にも",
            "direction": "vertical",
            "order": 4,
            "role": null
        },
        {
            "box": [
                715,
                35,
                732,
                132
            ],
            "contents": "問題があると",
            "direction": "vertical",
            "order": 5,
            "role": null
        },
        {
            "box": [
                618,
                34,
                708,
                211
            ],
            "contents": "痛感した瞬間でした。\n例えば、女性であること\nご高齢であること\nご病気があること",
            "direction": "vertical",
            "order": 6,
            "role": null
        },
        {
            "box": [
                594,
                35,
                611,
                132
            ],
            "contents": "様々な事情で",
            "direction": "vertical",
            "order": 7,
            "role": null
        },
        {
            "box": [
                568,
                35,
                587,
                160
            ],
            "contents": "働けないこと ...。",
            "direction": "vertical",
            "order": 8,
            "role": null
        },
        {
            "box": [
                547,
                35,
                563,
                128
            ],
            "contents": "誰にとっても",
            "direction": "vertical",
            "order": 9,
            "role": null
        },
        {
            "box": [
                521,
                35,
                540,
                170
            ],
            "contents": "居心地の良い環境、",
            "direction": "vertical",
            "order": 10,
            "role": null
        },
        {
            "box": [
                495,
                33,
                516,
                173
            ],
            "contents": "社会をつくります。",
            "direction": "vertical",
            "order": 11,
            "role": null
        },
        {
            "box": [
                473,
                35,
                491,
                116
            ],
            "contents": "全ての人に",
            "direction": "vertical",
            "order": 12,
            "role": null
        },
        {
            "box": [
                447,
                34,
                467,
                184
            ],
            "contents": "居場所のある社会!",
            "direction": "vertical",
            "order": 13,
            "role": null
        },
        {
            "box": [
                422,
                32,
                445,
                120
            ],
            "contents": "その社会を",
            "direction": "vertical",
            "order": 14,
            "role": null
        },
        {
            "box": [
                400,
                34,
                419,
                168
            ],
            "contents": "私が実現します!",
            "direction": "vertical",
            "order": 15,
            "role": null
        },
        {
            "box": [
                367,
                121,
                392,
                209
            ],
            "contents": "小山ちは",
            "direction": "vertical",
            "order": 16,
            "role": null
        },
        {
            "box": [
                269,
                35,
                307,
                191
            ],
            "contents": "ぼっとけない!\nこんな社会をめざすこと",
            "direction": "vertical",
            "order": 17,
            "role": "section_headings"
        },
        {
            "box": [
                217,
                13,
                252,
                197
            ],
            "contents": "笑顔で安心して\n子育てができる社会へ",
            "direction": "vertical",
            "order": 18,
            "role": null
        },
        {
            "box": [
                171,
                36,
                204,
                194
            ],
            "contents": "どんな境選でも、\n働く場所が見つかる社会へ",
            "direction": "vertical",
            "order": 19,
            "role": null
        },
        {
            "box": [
                125,
                36,
                158,
                189
            ],
            "contents": "命の価値はみんな同じ、\n誰もが平等に学べる社会へ",
            "direction": "vertical",
            "order": 20,
            "role": null
        },
        {
            "box": [
                266,
                213,
                318,
                243
            ],
            "contents": "小山ちほの\n情報は\nこちら",
            "direction": "horizontal",
            "order": 21,
            "role": null
        },
        {
            "box": [
                79,
                93,
                112,
                252
            ],
            "contents": "全ての人にそれぞれの\n居場所と役割がある社会へ",
            "direction": "vertical",
            "order": 24,
            "role": null
        },
        {
            "box": [
                34,
                75,
                66,
                242
            ],
            "contents": "農業·観光が息づく東三河を、\n安心·安全な社会へ",
            "direction": "vertical",
            "order": 25,
            "role": null
        },
        {
            "box": [
                25,
                284,
                165,
                299
            ],
            "contents": "◆小山ちほプロフィール",
            "direction": "horizontal",
            "order": 26,
            "role": null
        },
        {
            "box": [
                1068,
                333,
                1212,
                374
            ],
            "contents": "中道改革連合\n愛知第15区総支部長",
            "direction": "horizontal",
            "order": 27,
            "role": null
        },
        {
            "box": [
                25,
                303,
                254,
                369
            ],
            "contents": "曽祖母の攻都が豊橋市東涌谷町.50歳、東京電十大学短期期\n大学部卒業、長男不登校、次男指定難術·重度知的障がい。\nイオン、ニトリにて営業務を経歴、自身の経験を生かし。障が\nい福祉会社へ入社 その後は、川口市議として活動。2024\n年衆議院議員に初当選、内閣委員会·厚生労働委員会所属。",
            "direction": "horizontal",
            "order": 28,
            "role": null
        }
    ],
